{
  "name": "familyforge",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "powershell -Command \"$env:EXPO_ROUTER_APP_ROOT='src/app'; expo start\"",
    "android": "powershell -Command \"$env:EXPO_ROUTER_APP_ROOT='src/app'; expo start --android\"",
    "ios": "powershell -Command \"$env:EXPO_ROUTER_APP_ROOT='src/app'; expo start --ios\"",
    "web": "powershell -Command \"$env:EXPO_ROUTER_APP_ROOT='src/app'; expo start --web\"",
    "web:build": "cross-env EXPO_ROUTER_APP_ROOT=src/app expo export --platform web",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "admin:dev": "bunx vite --config admin/vite.config.ts",
    "admin:build": "bunx vite build --config admin/vite.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.2.3",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-query": "^5.60.6",
    "@types/react-native-maps": "^0.24.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "expo": "~54.0.0",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "^19.0.8",
    "expo-module-scripts": "^5.0.8",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.468.0",
    "nativewind": "^4.1.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.20.7",
    "react-native-maps": "^1.27.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.5.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  }
}
